# Cloudflare Pages reads this file from the root of the published directory.
# Everything in public/ is copied into out/ verbatim, so this lands correctly.
#
# Next.js exports the generated Open Graph cards to extensionless paths
# (out/opengraph-image), and Cloudflare infers content type from the file
# extension. Without these rules the cards are served as
# application/octet-stream and every social preview silently fails.

/opengraph-image
  Content-Type: image/png

/work/*/opengraph-image
  Content-Type: image/png
